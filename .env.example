# Supabase PostgreSQL (Dashboard > Project Settings > Database > Connection string)
# Gunakan Transaction pooler untuk runtime, Session pooler untuk Prisma CLI/migrations.

# DATABASE_URL - Transaction pooler (port 6543), untuk runtime app/serverless
# Format: postgresql://postgres.tvqfaedistxuycjlzato:SVi7qXMCyGvA1p9U@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# DIRECT_URL - Session pooler (port 5432), untuk Prisma CLI (migrate deploy/status/studio/db push)
# Jangan pakai transaction pooler (6543) untuk migrations.
# Format: postgresql://postgres.tvqfaedistxuycjlzato:SVi7qXMCyGvA1p9U@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# Jika direct connection IPv4 tersedia, bisa juga: postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=""

# Secret sesi aplikasi (minimal 32 karakter acak)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="3c6e2f8e49591ce111e317bfb6eb1464de213ff803dc35c693ddc9b887c66540"

# URL server yang dipakai APK/web
CAPACITOR_SERVER_URL="https://kasir-seafood-experiment.vrtx-lab.workers.dev"
CAPACITOR_APP_ID="id.vianjaya.kasir.cabang1"
CAPACITOR_APP_NAME="Kasir Vian Jaya 08 - Cabang 1"
